# Copy to .env and fill in the values before `docker compose up`.
# DATABASE_URL is NOT set here: docker-compose.yml builds it itself from
# POSTGRES_PASSWORD, so the app/migrator always point at the compose-managed
# postgres container.

PROVIDER_API_KEY=sk-or-...        # required — the API key for your model provider (OpenRouter by default)
POSTGRES_PASSWORD=postgres          # change this for any real deployment
# PROVIDER_BASE_URL=https://openrouter.ai/api/v1  # optional — point at any OpenAI-compatible endpoint (Ollama, LiteLLM, vLLM); defaults to OpenRouter
# APP_URL=http://localhost:3000       # optional — set when serving on a host other than localhost:3000; the CSRF origin check only trusts hosts on its allowlist (localhost:3000, 127.0.0.1:3000, and APP_URL)

# MCP auth secret references: an auth header value that starts with AGENTLATHE_SECRET_
# is treated as the NAME of an env var and resolved when the app connects to that MCP
# server — only the name is stored in the database, so dumps and backups never carry
# the secret. The variable must hold the FULL header value ("Bearer ghp_..." included)
# and be visible to the app process: compose forwards everything in this file to the
# `app` container; without Docker, put it in apps/web/.env.local instead.
# AGENTLATHE_SECRET_GITHUB_PAT=Bearer ghp_...

# The variables below are not read by docker-compose.yml — they only matter if
# you run the e2e suite or one of the seed scripts directly (pnpm --filter ...),
# not through `docker compose up`.
# E2E_MODEL=~deepseek/deepseek-v4-flash-latest  # optional — OpenRouter model slug for the e2e suites; defaults to ~deepseek/deepseek-v4-flash-latest if unset (the leading ~ is OpenRouter's "always latest" alias convention, not a typo)
# SEED_MODEL=llama3.3  # optional — model slug used by `seed` and `seed:demo`; defaults to ~deepseek/deepseek-v4-flash-latest; set this when PROVIDER_BASE_URL points at an endpoint that doesn't serve OpenRouter's default models (e.g. Ollama, LiteLLM, vLLM — their model ids are usually unprefixed)
# SEED_RUN_DAYS=30                    # optional — how many days of history `seed:runs` fabricates synthetic runs over
# SEED_RUNS_PER_DAY=9                 # optional — average synthetic runs per day for `seed:runs`
